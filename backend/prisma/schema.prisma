generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  role               UserRole
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  playerProfile      PlayerProfile?
  trainerAssignments TrainerAssignment[] @relation("TrainerAssignments")

  @@index([email])
  @@index([role])
  @@map("users")
}

model PlayerProfile {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  username               String              @unique
  rank                   String              @default("Cadet")
  winRate                Float               @default(0.0)
  averageScore           Float               @default(0.0)
  missionsCompleted      Int                 @default(0)
  totalTimeSpent         Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  totalScore             Float               @default(0.0)
  experiencePoints       Int                 @default(0)
  level                  Int                 @default(1)
  totalMissionsAttempted Int                 @default(0)
  totalMissionsCompleted Int                 @default(0)
  missionResults         MissionResult[]
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTrainers       TrainerAssignment[] @relation("AssignedToTrainers")

  @@index([username])
  @@index([totalScore])
  @@map("player_profiles")
}

model Mission {
  id                 String          @id @default(cuid())
  title              String
  description        String
  difficulty         Difficulty
  type               MissionType
  duration           Int
  status             MissionStatus   @default(DRAFT)
  learningObjectives String[]        @default([])
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  results            MissionResult[]

  @@index([difficulty, type, status])
  @@index([status])
  @@index([createdBy])
  @@map("missions")
}

model MissionResult {
  id           String        @id @default(cuid())
  missionId    String
  playerId     String
  score        Float
  timeSpent    Int
  completedAt  DateTime      @default(now())
  isCompleted  Boolean       @default(true)
  achievements String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mission      Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@index([playerId])
  @@index([completedAt])
  @@map("mission_results")
}

model TrainerAssignment {
  id         String        @id @default(cuid())
  trainerId  String
  playerId   String
  assignedAt DateTime      @default(now())
  assignedBy String
  player     PlayerProfile @relation("AssignedToTrainers", fields: [playerId], references: [id], onDelete: Cascade)
  trainer    User          @relation("TrainerAssignments", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, playerId])
  @@index([trainerId])
  @@index([playerId])
  @@map("trainer_assignments")
}

enum UserRole {
  ADMIN
  TRAINER
  LEARNER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MissionType {
  PVE
  PVP
}

enum MissionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
